@startuml
title GoodsHub — Database Relationships
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam classBackgroundColor #F1F5FB
skinparam classBorderColor #365579
hide circle
entity CATEGORIES {
 * id : INTEGER <<PK>>
 --
 * name : TEXT <<UK>>
}
entity GOODS {
 * id : INTEGER <<PK>>
 --
 * code : TEXT <<UK>>
 * name : TEXT
 * category_id : INTEGER <<FK>>
 * unit : TEXT
 * weight : REAL
 * description : TEXT
 * status : TEXT
 * created_at : TEXT
 * updated_at : TEXT
 * photo_filename : TEXT
}
entity AUDIT_LOG {
 * id : INTEGER <<PK>>
 --
 * entity_type : TEXT
 * entity_id : INTEGER
 * entity_label : TEXT
 * action : TEXT
 before_json : TEXT
 after_json : TEXT
 * created_at : TEXT
}
CATEGORIES ||--o{ GOODS : classifies
note bottom of AUDIT_LOG
entity_type + entity_id identify the historical subject.
No foreign key: history survives deletion.
end note
legend bottom
PK = primary key | FK = foreign key | UK = unique key
* = NOT NULL; empty strings are permitted for optional text fields.
endlegend
@enduml
